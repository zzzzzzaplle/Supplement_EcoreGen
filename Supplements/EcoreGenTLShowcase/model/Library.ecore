  <eClassifiers xsi:type="ecore:EClass" name="Loan">
    <eOperations name="calculateFine">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="true"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Summary: Computes the overdue fee based on the difference between the actual return date (or today if still outstanding) and the due date, at a fixed rate of $0.50 per day. Only positive differences incur a charge.&#xA;Algorithm: &#xA;  if returnedDate != null then&#xA;    daysOverdue = daysBetween(returnedDate, dueDate)&#xA;  else&#xA;    daysOverdue = daysBetween(today(), dueDate)&#xA;  if daysOverdue > 0 then&#xA;    return daysOverdue * 0.50&#xA;  else&#xA;    return 0.0&#xA;Related Features: returnedDate, dueDate attributes&#xA;Related Classes: None&#xA;Input: None (operates on the current Loan instance)&#xA;Output: double - the overdue fine amount in dollars, non-negative&#xA;Pre-condition: None&#xA;Post-condition: None (read-only operation)"/>
        <details key="body" value="// TODO: Please generate a body of this unimplemented method based on the docstring&#xD;&#xA;// TODO: Replace the current body with the generated body &#xD;&#xA;// TODO: Ensure that you mark it @generated NOT after code completion&#xD;&#xA;throw new UnsupportedOperationException();&#xD;&#xA;"/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    </eOperations>
    <eOperations name="extendDueDate">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="true"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Summary: Extends the due date by the requested number of days if the loan is not returned, not overdue, and has not been extended before (maximum one extension per loan).&#xA;Algorithm:&#xA;  if isReturned() == true then return false&#xA;  if isOverdue() == true then return false&#xA;  if extensionCount >= 1 then return false&#xA;  dueDate = dueDate.addDays(extraDays)&#xA;  extensionCount = extensionCount + 1&#xA;  return true&#xA;Related Features: dueDate, extensionCount attributes; isReturned(), isOverdue() methods&#xA;Related Classes: None&#xA;Input: extraDays : int - number of days to extend the due date, must be positive&#xA;Output: boolean - true if extension was successful, false otherwise&#xA;Pre-condition: extraDays > 0&#xA;Post-condition: If successful, dueDate is increased by extraDays, extensionCount is incremented by 1, and true is returned; otherwise no change and false is returned."/>
        <details key="body" value="// TODO: Please generate a body of this unimplemented method based on the docstring&#xD;&#xA;// TODO: Replace the current body with the generated body &#xD;&#xA;// TODO: Ensure that you mark it @generated NOT after code completion&#xD;&#xA;throw new UnsupportedOperationException();&#xD;&#xA;"/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
      <eParameters name="extraDays">
        <eType xsi:type="ecore:EDataType" href="http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
      </eParameters>
    </eOperations>
    <eOperations name="isOverdue">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="true"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Summary: Checks whether the loan is currently overdue (past the due date and not yet returned).&#xA;Algorithm:&#xA;  if isReturned() == true then return false&#xA;  return today() > dueDate&#xA;Related Features: dueDate attribute; isReturned() method&#xA;Related Classes: None&#xA;Input: None (operates on the current Loan instance)&#xA;Output: boolean - true if overdue, false otherwise&#xA;Pre-condition: None&#xA;Post-condition: None (read-only operation)"/>
        <details key="body" value="// TODO: Please generate a body of this unimplemented method based on the docstring&#xD;&#xA;// TODO: Replace the current body with the generated body &#xD;&#xA;// TODO: Ensure that you mark it @generated NOT after code completion&#xD;&#xA;throw new UnsupportedOperationException();&#xD;&#xA;"/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    </eOperations>
    <eOperations name="isReturned">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="true"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Summary: Checks whether the loan has been returned (returnedDate is not null).&#xA;Algorithm: Return (returnedDate != null)&#xA;Related Features: returnedDate attribute&#xA;Related Classes: None&#xA;Input: None (operates on the current Loan instance)&#xA;Output: boolean - true if returned, false otherwise&#xA;Pre-condition: None&#xA;Post-condition: None (read-only operation)"/>
        <details key="body" value="// TODO: Please generate a body of this unimplemented method based on the docstring&#xD;&#xA;// TODO: Replace the current body with the generated body &#xD;&#xA;// TODO: Ensure that you mark it @generated NOT after code completion&#xD;&#xA;throw new UnsupportedOperationException();&#xD;&#xA;"/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    </eOperations>
