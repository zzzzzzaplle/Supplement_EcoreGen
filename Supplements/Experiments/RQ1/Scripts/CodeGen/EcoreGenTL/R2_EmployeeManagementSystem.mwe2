module sample
import org.eclipse.xtext.xtext.generator.*
import org.eclipse.xtext.xtext.generator.model.project.*
import edu.sei.mde.mwe2.*
var rootPath = ".."  // 工作区根目录
Workflow {
  component = edu.sei.mde.mwe2.EcoreGenerator {
    configuration = org.eclipse.xtext.xtext.generator.DefaultGeneratorModule {
      project = org.eclipse.xtext.xtext.generator.model.project.StandardProjectConfig {
        baseName = "R2_EmployeeManagementSystem"   
        rootPath = rootPath
        createEclipseMetaData = true
      }
      code = org.eclipse.xtext.xtext.generator.CodeConfig {
        encoding = "UTF-8"
        lineDelimiter = "\r\n"
        fileHeader = "/*\n * generated by Enhanced EcoreGen\n */"
        preferXtendStubs = false
      }
    }
    language = edu.sei.mde.mwe2.EcoreLanguage {
    	
      ecoreFile = "file:/E:/E-Workspace/R2_EmployeeManagementSystem/model/employee1.ecore"
      basePackage = "edu"//原来是edu.company 
      fileExtensions = "library"
      suppressInterfaces = true
      llmConfig = "conf.properties"
      // Replace <ECLIPSE_DSL_PLUGIN_DIR> with your Eclipse DSL plugins directory.
      classpath = '<ECLIPSE_DSL_PLUGIN_DIR>/org.eclipse.emf.ecore_<version>.jar'
      classpath = '<ECLIPSE_DSL_PLUGIN_DIR>/org.eclipse.emf.common_<version>.jar'
      classpath = '<ECLIPSE_DSL_PLUGIN_DIR>/gson-2.10.jar'
    }
    languageModule = 'edu.sei.mde.eecg.llm.languageModule.DefaultEnhancedEcoreGenModule'
  }
 
}