  <eClassifiers xsi:type="ecore:EClass" name="PA22Helper">
    <eOperations name="parseGameMap" eType="#//GameMap">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="manual"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="body" value="&#xA;    if (mapText == null)&#xA;    {&#xA;      throw new IllegalArgumentException(&quot;Invalid map file.&quot;);&#xA;    }&#xA;&#xA;    final List&lt;String> lines = java.util.Arrays.asList(mapText.split(&quot;\\R&quot;));&#xA;    if (lines.isEmpty() || lines.get(0).trim().isEmpty())&#xA;    {&#xA;      throw new IllegalArgumentException(&quot;Invalid map file.&quot;);&#xA;    }&#xA;&#xA;    final int undoLimit;&#xA;    try&#xA;    {&#xA;      undoLimit = Integer.parseInt(lines.get(0).trim());&#xA;    }&#xA;    catch (NumberFormatException e)&#xA;    {&#xA;      throw new IllegalArgumentException(&quot;Failed to parse undo limit.&quot;, e);&#xA;    }&#xA;&#xA;    if (undoLimit &lt; -1)&#xA;    {&#xA;      throw new IllegalArgumentException(&quot;invalid undo limit&quot;);&#xA;    }&#xA;&#xA;    final List&lt;String> mapLines = lines.subList(1, lines.size());&#xA;    if (mapLines.isEmpty())&#xA;    {&#xA;      throw new IllegalArgumentException(&quot;Invalid map file.&quot;);&#xA;    }&#xA;&#xA;    int maxHeight = mapLines.size();&#xA;    int maxWidth = 0;&#xA;    for (String line : mapLines)&#xA;    {&#xA;      if (line.length() > maxWidth)&#xA;      {&#xA;        maxWidth = line.length();&#xA;      }&#xA;    }&#xA;&#xA;    final Map&lt;Position, Entity> entityMap = new HashMap&lt;Position, Entity>();&#xA;    final EList&lt;Position> destinations = new org.eclipse.emf.common.util.BasicEList&lt;Position>();&#xA;&#xA;    final java.util.Set&lt;Integer> players = new java.util.HashSet&lt;>();&#xA;    final java.util.Set&lt;Integer> referencedPlayers = new java.util.HashSet&lt;>();&#xA;    int boxCount = 0;&#xA;&#xA;    for (int y = 0; y &lt; mapLines.size(); y++)&#xA;    {&#xA;      String line = mapLines.get(y);&#xA;      for (int x = 0; x &lt; line.length(); x++)&#xA;      {&#xA;        char ch = line.charAt(x);&#xA;&#xA;        Position position = Pa22Factory.eINSTANCE.createPosition();&#xA;        position.setX(x);&#xA;        position.setY(y);&#xA;&#xA;        switch (ch)&#xA;        {&#xA;          case '#':&#xA;            entityMap.put(position, Pa22Factory.eINSTANCE.createWall());&#xA;            break;&#xA;          case '.':&#xA;            entityMap.put(position, Pa22Factory.eINSTANCE.createEmpty());&#xA;            break;&#xA;          case '@':&#xA;            destinations.add(position);&#xA;            entityMap.put(position, Pa22Factory.eINSTANCE.createEmpty());&#xA;            break;&#xA;          default:&#xA;            if (ch >= 'A' &amp;&amp; ch &lt;= 'Z')&#xA;            {&#xA;              int playerId = ch - 'A';&#xA;              if (!players.add(playerId))&#xA;              {&#xA;                throw new IllegalArgumentException(&quot;duplicate players detected in the map&quot;);&#xA;              }&#xA;&#xA;              Player player = Pa22Factory.eINSTANCE.createPlayer();&#xA;              player.setId(playerId);&#xA;              entityMap.put(position, player);&#xA;            }&#xA;            else if (ch >= 'a' &amp;&amp; ch &lt;= 'z')&#xA;            {&#xA;              int playerId = Character.toUpperCase(ch) - 'A';&#xA;              referencedPlayers.add(playerId);&#xA;              boxCount++;&#xA;&#xA;              Box box = Pa22Factory.eINSTANCE.createBox();&#xA;              box.setPlayerId(playerId);&#xA;              entityMap.put(position, box);&#xA;            }&#xA;            break;&#xA;        }&#xA;      }&#xA;    }&#xA;&#xA;    if (players.isEmpty())&#xA;    {&#xA;      throw new IllegalArgumentException(&quot;no player&quot;);&#xA;    }&#xA;&#xA;    if (destinations.size() != boxCount)&#xA;    {&#xA;      throw new IllegalArgumentException(&quot;mismatch destinations&quot;);&#xA;    }&#xA;&#xA;    if (!referencedPlayers.equals(players))&#xA;    {&#xA;      throw new IllegalArgumentException(&quot;unmatched players&quot;);&#xA;    }&#xA;&#xA;    GameMap gameMap = Pa22Factory.eINSTANCE.createGameMap();&#xA;    gameMap.setMaxWidth(maxWidth);&#xA;    gameMap.setMaxHeight(maxHeight);&#xA;    gameMap.setUndoLimit(undoLimit);&#xA;    gameMap.getDestinations().addAll(destinations);&#xA;    gameMap.setMap(entityMap);&#xA;    return gameMap;&#xA; "/>
      </eAnnotations>
      <eParameters name="mapText" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eOperations>
    <eOperations name="createGameMap1" eType="#//GameMap">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="manual"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="body" value="GameMap gameMap = Pa22Factory.eINSTANCE.createGameMap();&#xA;        gameMap.setMaxWidth(maxWidth);&#xA;        gameMap.setMaxHeight(maxHeight);&#xA;        gameMap.setUndoLimit(undoLimit);&#xA;        &#xA;        if (destinations != null) {&#xA;            gameMap.getDestinations().addAll(destinations);&#xA;        }&#xA;        &#xA;        // Initialize transient attribute map&#xA;        gameMap.setMap(new HashMap&lt;>());&#xA;        &#xA;        return gameMap;"/>
      </eAnnotations>
      <eParameters name="maxWidth" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
      <eParameters name="maxHeight" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
      <eParameters name="destinations" upperBound="-1" eType="#//Position"/>
      <eParameters name="undoLimit" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    </eOperations>
    <eOperations name="createGameMap2" eType="#//GameMap">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="manual"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="body" value="GameMap gameMap = Pa22Factory.eINSTANCE.createGameMap();&#xA;        &#xA;        // EMF interface calls must use getX() and getY()&#xA;        int maxWidth = map.keySet().stream().mapToInt(Position::getX).max().orElse(0) + 1;&#xA;        int maxHeight = map.keySet().stream().mapToInt(Position::getY).max().orElse(0) + 1;&#xA;        &#xA;        gameMap.setMaxWidth(maxWidth);&#xA;        gameMap.setMaxHeight(maxHeight);&#xA;        gameMap.setUndoLimit(undoLimit);&#xA;        &#xA;        if (destinations != null) {&#xA;            gameMap.getDestinations().addAll(destinations);&#xA;        }&#xA;        &#xA;        // Set immutable Map&#xA;        gameMap.setMap(Collections.unmodifiableMap(map));&#xA;        &#xA;        return gameMap;"/>
      </eAnnotations>
      <eParameters name="destinations" upperBound="-1" eType="#//Position"/>
      <eParameters name="undoLimit" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
      <eParameters name="map">
        <eGenericType eClassifier="#//EntityMap">
          <eTypeArguments eClassifier="#//Position"/>
