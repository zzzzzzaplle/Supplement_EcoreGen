      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="body" value="java.util.Map&lt;edu.pa22.Position, edu.pa22.Position> movesMap = this.getMoves();&#xA;        if (movesMap == null) {&#xA;            movesMap = new java.util.HashMap&lt;>();&#xA;            this.setMoves(movesMap);&#xA;        }&#xA;&#xA;        final edu.pa22.Position key = movesMap.entrySet().stream()&#xA;                .filter(e -> e.getValue().equals(from))&#xA;                .map(java.util.Map.Entry::getKey)&#xA;                .findFirst().orElse(from);&#xA;        &#xA;        movesMap.put(key, to);"/>
      </eAnnotations>
      <eParameters name="from" eType="#//Position"/>
      <eParameters name="to" eType="#//Position"/>
    </eOperations>
    <eOperations name="reverse" eType="#//GameStateTransition">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="manual"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="body" value="java.util.Map&lt;edu.pa22.Position, edu.pa22.Position> movesMap = this.getMoves();&#xA;        if (movesMap == null) {&#xA;            movesMap = new java.util.HashMap&lt;>();&#xA;        }&#xA;&#xA;        final java.util.Map&lt;edu.pa22.Position, edu.pa22.Position> reversedMoves = movesMap.entrySet().stream()&#xA;                .collect(java.util.stream.Collectors.toMap(&#xA;                        java.util.Map.Entry::getValue, &#xA;                        java.util.Map.Entry::getKey&#xA;                ));&#xA;&#xA;        edu.pa22.GameStateTransition reversedTransition = edu.pa22.Pa22Factory.eINSTANCE.createGameStateTransition();&#xA;        reversedTransition.setMoves(reversedMoves);&#xA;        &#xA;        return reversedTransition;"/>
      </eAnnotations>
    </eOperations>
