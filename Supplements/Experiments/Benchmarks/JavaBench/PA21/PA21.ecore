  <eClassifiers xsi:type="ecore:EClass" name="GameBoardView">
    <eOperations name="output">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="manual"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="body" value="// Assume gameBoard is an instance of pa21.GameBoard interface&#xA;for (int r = 0; r &lt; gameBoard.getNumRows(); ++r) {&#xA;    for (int c = 0; c &lt; gameBoard.getNumCols(); ++c) {&#xA;        // Call the getCell1(EInt, EInt) operation defined in Ecore&#xA;        final Cell cell = gameBoard.getCell1(r, c);&#xA;        &#xA;        // Call the EOperation modeled in the Cell interface&#xA;        // These methods already contain concrete logic through Method Injection&#xA;        final char ch = useUnicodeChars ? cell.toUnicodeChar() : cell.toASCIIChar();&#xA;&#xA;        System.out.print(ch);&#xA;    }&#xA;    System.out.println();&#xA;}"/>
      </eAnnotations>
      <eParameters name="useUnicodeChars" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    </eOperations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="gameBoard" eType="#//GameBoard"/>
