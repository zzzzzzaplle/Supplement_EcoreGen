  <eClassifiers xsi:type="ecore:EEnum" name="PipeShape">
    <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
      <details key="requirement" value="{&#xA;  &quot;Operations&quot;: [&#xA;    {&#xA;      &quot;name&quot;: &quot;getCharByState&quot;,&#xA;      &quot;returnType&quot;: &quot;char&quot;,&#xA;      &quot;parameters&quot;: [{&quot;name&quot;: &quot;isFilled&quot;, &quot;type&quot;: &quot;boolean&quot;}],&#xA;      &quot;logic&quot;: &quot;Return 'this.filledChar' if isFilled is true, otherwise return 'this.unfilledChar'.&quot;&#xA;    }&#xA;  ],&#xA;  &quot;PipeShapeMapping&quot;: {&#xA;    &quot;HORIZONTAL&quot;: {&#xA;      &quot;mapping_key&quot;: &quot;mapping_HZ&quot;,&#xA;      &quot;filled&quot;: &quot;PipePatterns.Filled.HORIZONTAL&quot;,&#xA;      &quot;unfilled&quot;: &quot;PipePatterns.Unfilled.HORIZONTAL&quot;&#xA;    },&#xA;    &quot;VERTICAL&quot;: {&#xA;      &quot;mapping_key&quot;: &quot;mapping_VT&quot;,&#xA;      &quot;filled&quot;: &quot;PipePatterns.Filled.VERTICAL&quot;,&#xA;      &quot;unfilled&quot;: &quot;PipePatterns.Unfilled.VERTICAL&quot;&#xA;    },&#xA;    &quot;TOP_LEFT&quot;: {&#xA;      &quot;mapping_key&quot;: &quot;mapping_TL&quot;,&#xA;      &quot;filled&quot;: &quot;PipePatterns.Filled.TOP_LEFT&quot;,&#xA;      &quot;unfilled&quot;: &quot;PipePatterns.Unfilled.TOP_LEFT&quot;&#xA;    },&#xA;    &quot;TOP_RIGHT&quot;: {&#xA;      &quot;mapping_key&quot;: &quot;mapping_TR&quot;,&#xA;      &quot;filled&quot;: &quot;PipePatterns.Filled.TOP_RIGHT&quot;,&#xA;      &quot;unfilled&quot;: &quot;PipePatterns.Unfilled.TOP_RIGHT&quot;&#xA;    },&#xA;    &quot;BOTTOM_LEFT&quot;: {&#xA;      &quot;mapping_key&quot;: &quot;mapping_BL&quot;,&#xA;      &quot;filled&quot;: &quot;PipePatterns.Filled.BOTTOM_LEFT&quot;,&#xA;      &quot;unfilled&quot;: &quot;PipePatterns.Unfilled.BOTTOM_LEFT&quot;&#xA;    },&#xA;    &quot;BOTTOM_RIGHT&quot;: {&#xA;      &quot;mapping_key&quot;: &quot;mapping_BR&quot;,&#xA;      &quot;filled&quot;: &quot;PipePatterns.Filled.BOTTOM_RIGHT&quot;,&#xA;      &quot;unfilled&quot;: &quot;PipePatterns.Unfilled.BOTTOM_RIGHT&quot;&#xA;    },&#xA;    &quot;CROSS&quot;: {&#xA;      &quot;mapping_key&quot;: &quot;mapping_CROSS&quot;,&#xA;      &quot;filled&quot;: &quot;PipePatterns.Filled.CROSS&quot;,&#xA;      &quot;unfilled&quot;: &quot;PipePatterns.Unfilled.CROSS&quot;&#xA;    }&#xA;  }&#xA;}"/>
    </eAnnotations>
    <eLiterals name="HORIZONTAL"/>
    <eLiterals name="VERTICAL" value="1"/>
    <eLiterals name="TOP_LEFT" value="2"/>
    <eLiterals name="TOP_RIGHT" value="3"/>
    <eLiterals name="BOTTOM_LEFT" value="4"/>
    <eLiterals name="BOTTOM_RIGHT" value="5"/>
    <eLiterals name="CROSS" value="6"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="TerminationType">
    <eLiterals name="SOURCE"/>
    <eLiterals name="SINK" value="1"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EDataType" name="cellarray" instanceClassName="edu.pa19.Cell[][]"/>
  <eClassifiers xsi:type="ecore:EClass" name="Pa19Helper">
    <eOperations name="createGame" eType="#//Game">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="manual"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="body" value=" Game game = Pa19Factory.eINSTANCE.createGame();&#xA;&#xA;        // 1. Initialize and set up Map&#xA;        Map map = Pa19Factory.eINSTANCE.createMap();&#xA;        map.setRows(rows);&#xA;        map.setCols(cols);&#xA;        map.setCell(cells);&#xA;        game.setMap(map);&#xA;&#xA;        // 2. Initialize and set up PipeQueue (call the fixed Helper method)&#xA;     // 2. Initialize and set up PipeQueue (complete assembly directly here)&#xA;        PipeQueue pq = Pa19Factory.eINSTANCE.createPipeQueue();&#xA;        List&lt;Pipe> internalPipeList = pq.getPipeQueue(); // Get the underlying EMF EList&#xA;        &#xA;        // If initial preset pipes were parsed from the file, add them first&#xA;        if (pipes != null) {&#xA;            internalPipeList.addAll(pipes);&#xA;        }&#xA;        // Fill the queue until it reaches the maximum length&#xA;        while (internalPipeList.size() &lt; pq.getMaxGenLength()) {&#xA;            internalPipeList.add(pq.generateNewPipe());&#xA;        }&#xA;        game.setPipeQueue(pq);&#xA;&#xA;        // 3. Initialize and set up DelayBar&#xA;        DelayBar delayBar = Pa19Factory.eINSTANCE.createDelayBar();&#xA;        delayBar.eSet(Pa19Package.Literals.DELAY_BAR__INITIAL_VALUE, delay);&#xA;        delayBar.setCurrentValue(delay);&#xA;        game.setDelayBar(delayBar);&#xA;        &#xA;        // 4. Initialize empty CellStack&#xA;        game.setCellStack(Pa19Factory.eINSTANCE.createCellStack());&#xA;&#xA;        return game;"/>
      </eAnnotations>
      <eParameters name="rows" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
      <eParameters name="cols" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
      <eParameters name="delay" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
      <eParameters name="cells" eType="#//cellarray"/>
      <eParameters name="pipes" upperBound="-1" eType="#//Pipe"/>
    </eOperations>
    <eOperations name="gameFromString" eType="#//Game">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="manual"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="body" value="  // 1. Use Deserializer to parse the text string into a Cell[][] 2D array&#xA;        Cell[][] cells = Deserializer.parseString(rows, cols, cellsRep);&#xA;        // 2. Pass the parsed 2D array directly to the createGame method above for overall assembly&#xA;        return createGame(rows, cols, delay, cells, pipes);"/>
      </eAnnotations>
      <eParameters name="rows" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
      <eParameters name="cols" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
      <eParameters name="delay" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
      <eParameters name="cellsRep" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eParameters name="pipes" upperBound="-1" eType="#//Pipe"/>
    </eOperations>
    <eOperations name="createMap" eType="#//Map">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="manual"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="body" value=" Map map = Pa19Factory.eINSTANCE.createMap();&#xA;        map.setRows(rows);&#xA;        map.setCols(cols);&#xA;        map.setCell(cells);&#xA;&#xA;        for (int r = 0; r &lt; rows; ++r) {&#xA;            for (int c = 0; c &lt; cols; ++c) {&#xA;                Cell cell = cells[r][c];&#xA;                if (cell instanceof TerminationCell) {&#xA;                    TerminationCell tCell = (TerminationCell) cell;&#xA;                    if (tCell.getType() == TerminationType.SOURCE) {&#xA;                        if (map.getSourceCell() != null) {&#xA;                            throw new IllegalArgumentException(&quot;Multiple source cells found&quot;);&#xA;                        }&#xA;                        map.setSourceCell(tCell);&#xA;                    } else if (tCell.getType() == TerminationType.SINK) {&#xA;                        if (map.getSinkCell() != null) {&#xA;                            throw new IllegalArgumentException(&quot;Multiple sink cells found&quot;);&#xA;                        }&#xA;                        map.setSinkCell(tCell);&#xA;                    }&#xA;                }&#xA;            }&#xA;        }&#xA;&#xA;        if (map.getSourceCell() == null || map.getSinkCell() == null) {&#xA;            throw new IllegalArgumentException(&quot;Source or sink cell not found&quot;);&#xA;        }&#xA;&#xA;        return map;"/>
      </eAnnotations>
      <eParameters name="rows" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
      <eParameters name="cols" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
      <eParameters name="cells" eType="#//cellarray"/>
    </eOperations>
    <eOperations name="mapFromString" eType="#//Map">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="manual"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="body" value=" Cell[][] cells = Deserializer.parseString(rows, cols, cellsRep);&#xA;        return createMap(rows, cols, cells);"/>
      </eAnnotations>
      <eParameters name="rows" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
      <eParameters name="cols" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
      <eParameters name="cellsRep" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eOperations>
    <eOperations name="cellFromChar" eType="#//Cell">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="manual"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="body" value="  &#x9;switch (c) {&#xA;&#x9;    &#x9;case 'W':&#xA;&#x9;    &#x9;return createWall(coord);&#xA;&#x9;    &#x9;case '.':&#xA;&#x9;    &#x9;return createFillableCell(coord, null);&#xA;&#x9;    &#x9;case '^':&#xA;&#x9;    &#x9;return terminationType == null ? null : createTerminationCell(coord, terminationType, Direction.UP);&#xA;&#x9;    &#x9;case '>':&#xA;&#x9;    &#x9;return terminationType == null ? null : createTerminationCell(coord, terminationType, Direction.RIGHT);&#xA;&#x9;    &#x9;case '&lt;':&#xA;&#x9;    &#x9;return terminationType == null ? null : createTerminationCell(coord, terminationType, Direction.LEFT);&#xA;&#x9;    &#x9;case 'v':&#xA;&#x9;    &#x9;return terminationType == null ? null : createTerminationCell(coord, terminationType, Direction.DOWN);&#xA;&#x9;    &#x9;default:&#xA;&#x9;    &#x9;return null;&#xA;&#x9;    &#x9;}"/>
      </eAnnotations>
      <eParameters name="c" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EChar"/>
      <eParameters name="coord" eType="#//Coordinate"/>
      <eParameters name="terminationType" eType="#//TerminationType"/>
    </eOperations>
    <eOperations name="createWall" eType="#//Wall">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="manual"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="body" value="  Wall wall = Pa19Factory.eINSTANCE.createWall();&#xA;        wall.setCoord(coord);&#xA;        return wall;"/>
      </eAnnotations>
      <eParameters name="coord" eType="#//Coordinate"/>
    </eOperations>
    <eOperations name="createFillableCell" eType="#//FillableCell">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="manual"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="body" value="  FillableCell cell = Pa19Factory.eINSTANCE.createFillableCell();&#xA;            cell.setCoord(coord);&#xA;            // If an initial pipe was passed in, assemble it into the cell&#xA;            if (pipes != null) {&#xA;                cell.setPipe(pipes);&#xA;            }&#xA;            return cell;"/>
      </eAnnotations>
      <eParameters name="coord" eType="#//Coordinate"/>
      <eParameters name="pipes" eType="#//Pipe"/>
    </eOperations>
    <eOperations name="createTerminationCell" eType="#//TerminationCell">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="manual"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="body" value="  TerminationCell cell = Pa19Factory.eINSTANCE.createTerminationCell();&#xA;        cell.setCoord(coord);&#xA;        cell.setType(type);&#xA;        cell.setPointingTo(dir);&#xA;        // Boolean attributes in EMF default to false, so no need to manually call setFilled(false)&#xA;        return cell;"/>
      </eAnnotations>
      <eParameters name="coord" eType="#//Coordinate"/>
      <eParameters name="type" eType="#//TerminationType"/>
      <eParameters name="dir" eType="#//Direction"/>
    </eOperations>
    <eOperations name="pipeFromString" eType="#//Pipe">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="manual"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="body" value="  if (rep == null) {&#xA;            throw new IllegalArgumentException(&quot;Unknown shape&quot;);&#xA;        }&#xA;&#xA;        String actualRep = rep.trim();&#xA;&#xA;        PipeShape shape;&#xA;        switch (actualRep) {&#xA;            case &quot;HZ&quot;:&#xA;                shape = PipeShape.HORIZONTAL;&#xA;                break;&#xA;            case &quot;VT&quot;:&#xA;                shape = PipeShape.VERTICAL;&#xA;                break;&#xA;            case &quot;TL&quot;:&#xA;                shape = PipeShape.TOP_LEFT;&#xA;                break;&#xA;            case &quot;TR&quot;:&#xA;                shape = PipeShape.TOP_RIGHT;&#xA;                break;&#xA;            case &quot;BL&quot;:&#xA;                shape = PipeShape.BOTTOM_LEFT;&#xA;                break;&#xA;            case &quot;BR&quot;:&#xA;                shape = PipeShape.BOTTOM_RIGHT;&#xA;                break;&#xA;            case &quot;CR&quot;:&#xA;                shape = PipeShape.CROSS;&#xA;                break;&#xA;            default:&#xA;                throw new IllegalArgumentException(&quot;Unknown shape&quot;);&#xA;        }&#xA;&#xA;        Pipe pipe = Pa19Factory.eINSTANCE.createPipe();&#xA;        pipe.setShape(shape);&#xA;        return pipe;"/>
      </eAnnotations>
      <eParameters name="rep" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eOperations>
    <eOperations name="getOpposite" eType="#//Direction">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="manual"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="body" value=" switch (dir) {&#xA;            case UP:&#xA;                return Direction.DOWN;&#xA;            case DOWN:&#xA;                return Direction.UP;&#xA;            case LEFT:&#xA;                return Direction.RIGHT;&#xA;            case RIGHT:&#xA;                return Direction.LEFT;&#xA;            default:&#xA;                throw new IllegalStateException(&quot;Unknown direction: &quot; + dir);&#xA;        }"/>
      </eAnnotations>
      <eParameters name="dir" eType="#//Direction"/>
    </eOperations>
    <eOperations name="getOffset" eType="#//Coordinate">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="manual"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="body" value="Coordinate offset = Pa19Factory.eINSTANCE.createCoordinate();&#xA;        switch (dir) {&#xA;            case UP:&#xA;                offset.setRow(-1);&#xA;                offset.setCol(0);&#xA;                break;&#xA;            case DOWN:&#xA;                offset.setRow(1);&#xA;                offset.setCol(0);&#xA;                break;&#xA;            case LEFT:&#xA;                offset.setRow(0);&#xA;                offset.setCol(-1);&#xA;                break;&#xA;            case RIGHT:&#xA;                offset.setRow(0);&#xA;                offset.setCol(1);&#xA;                break;&#xA;            default:&#xA;                throw new IllegalStateException(&quot;Unknown direction: &quot; + dir);&#xA;        }&#xA;        return offset;"/>
      </eAnnotations>
      <eParameters name="dir" eType="#//Direction"/>
    </eOperations>
  </eClassifiers>
