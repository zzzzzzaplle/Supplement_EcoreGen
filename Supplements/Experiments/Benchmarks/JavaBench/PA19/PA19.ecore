  <eClassifiers xsi:type="ecore:EEnum" name="Direction">
    <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
      <details key="requirement" value="Enum Direction: Represents four grid-based directions.&#xA;Requirements for generated methods:&#xA;&#xA;Operation getOpposite():&#xA;&#xA;Logic: Return the logical inverse direction using a switch-case statement.&#xA;&#xA;Mapping: UP &lt;-> DOWN, LEFT &lt;-> RIGHT.&#xA;&#xA;Fallback: Throw IllegalStateException for unknown values.&#xA;&#xA;&#xA;Operation getOffset():&#xA;&#xA;Logic: Return a unit offset as a newly instantiated Coordinate object using the custom constructor Coordinate(int row, int col).&#xA;&#xA;Mapping: UP -> (-1, 0), DOWN -> (1, 0), LEFT -> (0, -1), RIGHT -> (0, 1).&#xA;&#xA;Fallback: Throw IllegalStateException for unknown values."/>
    </eAnnotations>
    <eLiterals name="UP"/>
    <eLiterals name="DOWN" value="1"/>
    <eLiterals name="LEFT" value="2"/>
    <eLiterals name="RIGHT" value="3"/>
  </eClassifiers>
