    <eOperations name="equal">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="manual"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="body" value="if (this == o) return true;&#xA;if (o == null || getClass() != o.getClass()) return false;&#xA;Player player = (Player) o;&#xA;&#xA;// Use Getter to retrieve name attribute and compare&#xA;if (this.getName() == null) {&#xA;    return player.getName() == null;&#xA;}&#xA;return this.getName().equals(player.getName());"/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
      <eParameters name="o">
        <eType xsi:type="ecore:EDataType" href="http://www.eclipse.org/emf/2002/Ecore#//EJavaObject"/>
      </eParameters>
    </eOperations>
    <eOperations name="clone" eType="//Player">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="manual"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="body" value=" Player cloned;&#xA;    try {&#xA;      cloned = (Player) org.eclipse.emf.ecore.util.EcoreUtil.copy(this);&#xA;    } catch (Exception e) {&#xA;      try {&#xA;        java.lang.reflect.Constructor&lt;? extends Player> ctor =&#xA;            this.getClass().getDeclaredConstructor();&#xA;        ctor.setAccessible(true);&#xA;        cloned = ctor.newInstance();&#xA;      } catch (Exception ex) {&#xA;        throw new RuntimeException(&quot;Failed to clone Player of type &quot; + this.getClass().getName(), ex);&#xA;      }&#xA;    }&#xA;    cloned.setName(this.getName());&#xA;    cloned.setScore(this.getScore());&#xA;    cloned.setColor(this.getColor());&#xA;    return cloned;"/>
      </eAnnotations>
    </eOperations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" iD="true">
      <eType xsi:type="ecore:EDataType" href="http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="score" unique="false">
      <eType xsi:type="ecore:EDataType" href="http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="color" unique="false" eType="//Color"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Piece" abstract="true">
    <eOperations name="getLabel">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="true"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Summary:&#xA;Returns the character label used to display the piece on the board.&#xA;Algorithm:&#xA;1. Return the subclass-defined label.&#xA;Related Features:&#xA;- Piece.player&#xA;Related Classes: None&#xA;Input:&#xA;- None.&#xA;Output:&#xA;- A single character label.&#xA;  - Knight returns 'K'&#xA;  - Archer returns 'A'&#xA;Pre-condition:&#xA;- The concrete piece instance is initialized.&#xA;Post-condition:&#xA;- No state is changed."/>
        <details key="body" value="// TODO: Please generate a body of this unimplemented method based on the docstring&#xD;&#xA;// TODO: Replace the current body with the generated body &#xD;&#xA;// TODO: Ensure that you mark it @generated NOT after code completion&#xD;&#xA;throw new UnsupportedOperationException();&#xD;&#xA;"/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.eclipse.org/emf/2002/Ecore#//EChar"/>
    </eOperations>
    <eOperations name="getAvailableMoves" upperBound="-1" eType="//Move">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="true"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Summary:&#xA;Abstract operation that returns all legal moves for the piece from a source position.&#xA;Concrete subclasses must apply their own movement rules plus the global validation rules.&#xA;Algorithm:&#xA;1. Enumerate candidate destination squares according to the concrete piece’s movement pattern.&#xA;2. Apply global rules and piece-specific rules.&#xA;3. Return the final list of legal moves.&#xA;Related Features:&#xA;- Piece.player&#xA;- Piece.getLabel()&#xA;Related Classes: Game, Move, Place, Player&#xA;Input:&#xA;- game: current Game instance.&#xA;- source: current position of this piece.&#xA;Output:&#xA;- A list of legal moves for this piece.&#xA;Pre-condition:&#xA;- Implemented by a concrete subclass.&#xA;- game and source are not null.&#xA;Post-condition:&#xA;- No board state is changed.&#xA;- Returned moves are legal under this piece’s movement rules and global rules."/>
        <details key="body" value="// TODO: Please generate a body of this unimplemented method based on the docstring&#xD;&#xA;// TODO: Replace the current body with the generated body &#xD;&#xA;// TODO: Ensure that you mark it @generated NOT after code completion&#xD;&#xA;throw new UnsupportedOperationException();&#xD;&#xA;"/>
      </eAnnotations>
      <eParameters name="game" eType="//Game"/>
      <eParameters name="source" eType="//Place"/>
    </eOperations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="player" lowerBound="1" eType="//Player"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Configuration">
    <eOperations name="InitConfiguration">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="manual"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="body" value=" if (size&lt;3) {&#xA;        throw new InvalidConfigurationError(&quot;size of gameboard must be at least 3&quot;);&#xA;    }&#xA;    if (size % 2 != 1) {&#xA;        throw new InvalidConfigurationError(&quot;size of gameboard must be an odd number&quot;);&#xA;    }&#xA;    if (size > 25) {&#xA;        throw new InvalidConfigurationError(&quot;size of gameboard is at most 26&quot;);&#xA;    }&#xA;    this.setSize(size);&#xA;    &#xA;    // EMF 中 players 被映射为 EList，直接操作集合&#xA;    if (players == null || players.size() != 2) {&#xA;        throw new InvalidConfigurationError(&quot;there must be exactly two players&quot;);&#xA;    }&#xA;    this.getPlayers().clear();&#xA;    this.getPlayers().addAll(players);&#xA;    &#xA;    // 初始化二维数组，使用 EDataType 中定义的 instanceClassName (edu.pa20.Piece)&#xA;    edu.pa20.Piece[][] board = new edu.pa20.Piece[size][];&#xA;    for (int x = 0; x &lt; size; x++) {&#xA;        board[x] = new edu.pa20.Piece[size];&#xA;        for (int y = 0; y &lt; size; y++) {&#xA;            board[x][y] = null;&#xA;        }&#xA;    }&#xA;    this.setInitialBoard(board);&#xA;    &#xA;    // 使用 EMF Factory 实例化 Place&#xA;    Place center = Pa20Factory.eINSTANCE.createPlace();&#xA;    center.setX(size / 2);&#xA;    center.setY(size / 2);&#xA;    this.setCentralPlace(center);&#xA;    &#xA;    if (numMovesProtection &lt; 0) {&#xA;        throw new InvalidConfigurationError(&quot;number of moves with capture protection cannot be negative&quot;);&#xA;    }&#xA;    this.setNumMovesProtection(numMovesProtection);"/>
      </eAnnotations>
      <eParameters name="size">
        <eType xsi:type="ecore:EDataType" href="http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
      </eParameters>
      <eParameters name="players" upperBound="-1" eType="//Player"/>
      <eParameters name="numMovesProtection">
        <eType xsi:type="ecore:EDataType" href="http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
      </eParameters>
    </eOperations>
    <eOperations name="addInitialPiece">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="manual"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="body" value="// 使用 getPlayers().get(index) 访问 EList 中的元素&#xA;if (!piece.getPlayer().equals(this.getPlayers().get(0)) &amp;&amp; !piece.getPlayer().equals(this.getPlayers().get(1))) {&#xA;    throw new assignment.protocol.exception.InvalidConfigurationError(&quot;the player of the piece is unknown&quot;);&#xA;}&#xA;&#xA;// 使用 getX(), getY() 和 getSize() 获取属性&#xA;if (place.getX() >= this.getSize() || place.getY() >= this.getSize() || place.getX() &lt; 0 || place.getY() &lt; 0) {&#xA;    throw new assignment.protocol.exception.InvalidConfigurationError(&quot;the place (&quot; + place.getX() + &quot;, &quot; + place.getY() + &quot;) must be inside the gameboard&quot;);&#xA;}&#xA;&#xA;// EMF 默认的 equals 往往是引用比较，保险起见采用坐标值比对&#xA;Place central = this.getCentralPlace();&#xA;if (central != null &amp;&amp; place.getX() == central.getX() &amp;&amp; place.getY() == central.getY()) {&#xA;    throw new assignment.protocol.exception.InvalidConfigurationError(&quot;piece cannot be put at central place initially&quot;);&#xA;}&#xA;&#xA;// 获取二维数组并赋值&#xA;edu.pa20.Piece[][] board = this.getInitialBoard();&#xA;if (board != null) {&#xA;    board[place.getX()][place.getY()] = piece;&#xA;}"/>
      </eAnnotations>
      <eParameters name="piece" eType="//Piece"/>
      <eParameters name="place" eType="//Place"/>
    </eOperations>
    <eOperations name="addInitialPiece">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="manual"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="body" value="// Use EMF Factory to instantiate Place&#xA;Place tempPlace = Pa20Factory.eINSTANCE.createPlace();&#xA;tempPlace.setX(x);&#xA;tempPlace.setY(y);&#xA;&#xA;// Call the already adapted addInitialPiece(Piece piece, Place place)&#xA;this.addInitialPiece(piece, tempPlace);"/>
      </eAnnotations>
      <eParameters name="piece" eType="//Piece"/>
      <eParameters name="x">
        <eType xsi:type="ecore:EDataType" href="http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
      </eParameters>
      <eParameters name="y">
        <eType xsi:type="ecore:EDataType" href="http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
      </eParameters>
    </eOperations>
    <eOperations name="clone" eType="//Configuration">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="manual"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="body" value="// 使用 EMF 原生的复制机制作为基础&#xA;    Configuration cloned = (Configuration) org.eclipse.emf.ecore.util.EcoreUtil.copy(this);&#xA;    &#xA;    // 1. players 是非 containment 引用（测试里可能放入 MockPlayer 等非 EMF 对象），clone 时应保持引用语义&#xA;&#xA;    cloned.getPlayers().clear();&#xA;    cloned.getPlayers().addAll(this.getPlayers());&#xA;&#xA;    &#xA;    // 2. 深拷贝 initialBoard (PieceArray2D)&#xA;    // 必须手动分配新数组以脱离引用共享&#xA;    edu.pa20.Piece[][] origBoard = this.getInitialBoard();&#xA;    if (origBoard != null) {&#xA;        int sz = this.getSize();&#xA;        edu.pa20.Piece[][] newBoard = new edu.pa20.Piece[sz][];&#xA;        for (int i = 0; i &lt; sz; i++) {&#xA;            newBoard[i] = new edu.pa20.Piece[sz];&#xA;            // 浅拷贝 Piece 引用即可（符合原逻辑）&#xA;            System.arraycopy(origBoard[i], 0, newBoard[i], 0, sz);&#xA;        }&#xA;        cloned.setInitialBoard(newBoard);&#xA;    }&#xA;    &#xA;    // 3. centralPlace 处理说明：&#xA;    // 由于你在 Ecore 中将 centralPlace 设为了 containment=&quot;true&quot;，&#xA;    // EcoreUtil.copy(this) 已经自动在底层对其完成了深拷贝，因此无需再写 cloned.centralPlace = this.centralPlace.clone()。&#xA;    &#xA;    return cloned;"/>
      </eAnnotations>
    </eOperations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="size">
      <eType xsi:type="ecore:EDataType" href="http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="numMovesProtection">
      <eType xsi:type="ecore:EDataType" href="http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="players" lowerBound="2" upperBound="2" eType="//Player"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="centralPlace" lowerBound="1" eType="//Place" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="initialBoard" eType="//PieceArray2D"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EDataType" name="PieceArray2D" instanceClassName="edu.pa20.Piece[][]"/>
