  <eClassifiers xsi:type="ecore:EClass" name="JesonMor" eSuperTypes="//Game">
    <eOperations name="start" eType="//Player">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="true"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Summary:&#xA;Starts and runs the complete turn-based game loop until a winner is determined.&#xA;Algorithm:&#xA;1. Initialize current player from configuration.&#xA;2. Repeat until the game ends:&#xA;   - Compute available moves for current player.&#xA;   - If no moves exist, determine winner by score rule and terminate.&#xA;   - Ask current player for a move using nextMove(game, availableMoves).&#xA;   - Execute the move by calling movePiece.&#xA;   - Update the current player’s score using updateScore.&#xA;   - Increase numMoves.&#xA;   - Refresh the console output.&#xA;   - Evaluate winner using getWinner.&#xA;   - If a winner exists, terminate and return it.&#xA;   - Otherwise switch to the next player.&#xA;3. Return the winner.&#xA;Related Features:&#xA;- Game.currentPlayer&#xA;- Game.numMoves&#xA;- Game.getAvailableMoves(Player)&#xA;- Game.movePiece(Move)&#xA;- Game.updateScore(Player, Piece, Move)&#xA;- Game.refreshOutput()&#xA;- Game.getWinner(Player, Piece, Move)&#xA;Related Classes: Game, Move, Piece, Player&#xA;Input:&#xA;- None.&#xA;Output:&#xA;- The winning Player when the game ends.&#xA;Pre-condition:&#xA;- The configuration is valid and fully initialized.&#xA;- Players and initial board setup are available.&#xA;Post-condition:&#xA;- The game loop has executed until a terminal condition.&#xA;- numMoves and player scores reflect all successful moves made during the game."/>
        <details key="body" value="// TODO: Please generate a body of this unimplemented method based on the docstring&#xD;&#xA;// TODO: Replace the current body with the generated body &#xD;&#xA;// TODO: Ensure that you mark it @generated NOT after code completion&#xD;&#xA;throw new UnsupportedOperationException();&#xD;&#xA;"/>
      </eAnnotations>
    </eOperations>
    <eOperations name="getWinner" eType="//Player">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="true"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Summary:&#xA;Determines the winner after a move or when a player has no available moves, using the&#xA;protection rule, piece-removal rule, knight-central-square rule, and score tiebreak rule.&#xA;Algorithm:&#xA;1. If the game is still in protection phase (numMoves &lt; numMovesProtection), return null.&#xA;2. Check if only one player's pieces remain:&#xA;   - If yes, return the remaining player's owner.&#xA;3. Check if the last move caused a Knight to leave the central square:&#xA;   - If lastPiece is a Knight and lastMove.source equals central place and&#xA;     lastMove.destination does not equal central place, return lastPlayer.&#xA;4. If the current player has no available moves:&#xA;   - Compare current player score with the other player's score.&#xA;   - Return the player with the higher score.&#xA;   - If scores are equal, return the current player.&#xA;5. Otherwise return null.&#xA;Related Features:&#xA;- Game.numMoves&#xA;- Game.configuration.numMovesProtection&#xA;- Game.getCentralPlace()&#xA;- Game.getAvailableMoves(Player)&#xA;- Player.score&#xA;Related Classes: Game, Move, Piece, Player, Place, Knight&#xA;Input:&#xA;- lastPlayer: player who made the most recent successful move.&#xA;- lastPiece: the moved piece.&#xA;- lastMove: the most recent move.&#xA;Output:&#xA;- The winning Player if a win condition is satisfied.&#xA;- null if the game should continue.&#xA;Pre-condition:&#xA;- game state is initialized.&#xA;- lastPlayer, lastPiece, and lastMove are not null when evaluating a just-completed move.&#xA;Post-condition:&#xA;- No state is modified.&#xA;- Protection phase prevents winner declaration."/>
        <details key="body" value="// TODO: Please generate a body of this unimplemented method based on the docstring&#xD;&#xA;// TODO: Replace the current body with the generated body &#xD;&#xA;// TODO: Ensure that you mark it @generated NOT after code completion&#xD;&#xA;throw new UnsupportedOperationException();&#xD;&#xA;"/>
      </eAnnotations>
      <eParameters name="lastPlayer" eType="//Player"/>
      <eParameters name="lastPiece" eType="//Piece"/>
      <eParameters name="lastMove" eType="//Move"/>
    </eOperations>
    <eOperations name="updateScore">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="true"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Summary:&#xA;Increases a player's score by the Manhattan distance between the source and destination of a successful move.&#xA;Algorithm:&#xA;1. Compute dx = abs(move.destination.x - move.source.x).&#xA;2. Compute dy = abs(move.destination.y - move.source.y).&#xA;3. Increase player.score by dx + dy.&#xA;Related Features:&#xA;- Player.score&#xA;- Move.source&#xA;- Move.destination&#xA;Related Classes: Move, Player, Place&#xA;Input:&#xA;- player: the player whose score will be updated.&#xA;- piece: the moved piece, used to support score updates after a successful move.&#xA;- move: the executed move.&#xA;Output:&#xA;- None.&#xA;Pre-condition:&#xA;- player, piece, and move are not null.&#xA;- move has already been executed successfully.&#xA;Post-condition:&#xA;- player.score increases by the Manhattan distance of the move.&#xA;- No other state is modified."/>
        <details key="body" value="// TODO: Please generate a body of this unimplemented method based on the docstring&#xD;&#xA;// TODO: Replace the current body with the generated body &#xD;&#xA;// TODO: Ensure that you mark it @generated NOT after code completion&#xD;&#xA;throw new UnsupportedOperationException();&#xD;&#xA;"/>
      </eAnnotations>
      <eParameters name="player" eType="//Player"/>
      <eParameters name="piece" eType="//Piece"/>
      <eParameters name="move" eType="//Move"/>
    </eOperations>
    <eOperations name="movePiece">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="true"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Summary:&#xA;Moves a piece on the internal board from source to destination, clearing the source square.&#xA;This method performs the board update for a move that has already been validated.&#xA;Algorithm:&#xA;1. Read the piece from move.source.&#xA;2. Write that piece into move.destination on the board array.&#xA;3. Set move.source on the board array to null.&#xA;4. If the move is a capture, the destination occupant is replaced by the moving piece.&#xA;Related Features:&#xA;- Game.board&#xA;- Game.getPiece(Place)&#xA;- Game.getPiece(int, int)&#xA;Related Classes: Game, Move, Place, Piece&#xA;Input:&#xA;- move: a validated move to execute.&#xA;Output:&#xA;- None.&#xA;Pre-condition:&#xA;- move is valid and has passed all applicable rules.&#xA;- move.source contains a piece.&#xA;- move.destination is within the board.&#xA;Post-condition:&#xA;- The moving piece occupies the destination square.&#xA;- The source square becomes empty (null).&#xA;- No score is changed by this method alone."/>
        <details key="body" value="// TODO: Please generate a body of this unimplemented method based on the docstring&#xD;&#xA;// TODO: Replace the current body with the generated body &#xD;&#xA;// TODO: Ensure that you mark it @generated NOT after code completion&#xD;&#xA;throw new UnsupportedOperationException();&#xD;&#xA;"/>
      </eAnnotations>
      <eParameters name="move" lowerBound="1" eType="//Move"/>
    </eOperations>
    <eOperations name="getAvailableMoves" upperBound="-1" eType="//Move">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="true"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Summary:&#xA;Returns the aggregated set of legal moves for the given player by collecting the legal&#xA;moves of each piece owned by that player.&#xA;Algorithm:&#xA;1. Create an empty move list.&#xA;2. Iterate over every board position or every piece belonging to the player.&#xA;3. For each owned piece:&#xA;   - Call piece.getAvailableMoves(game, position).&#xA;   - Append all returned moves to the aggregate list.&#xA;4. Return the aggregate list without further filtering.&#xA;Related Features:&#xA;- Game.board&#xA;- Game.configuration&#xA;- Game.getPiece(Place)&#xA;- Game.getPlayer()&#xA;Related Classes: Game, Move, Piece, Player, Place&#xA;Input:&#xA;- player: the player whose legal moves are requested.&#xA;Output:&#xA;- A List&lt;Move> containing all legal moves for all pieces owned by player.&#xA;- The result may contain multiple moves from different pieces, and may be empty.&#xA;Pre-condition:&#xA;- player is not null.&#xA;- the game board and configuration are initialized.&#xA;Post-condition:&#xA;- No board state is changed.&#xA;- Returned moves are already validated by each piece implementation."/>
        <details key="body" value="// TODO: Please generate a body of this unimplemented method based on the docstring&#xD;&#xA;// TODO: Replace the current body with the generated body &#xD;&#xA;// TODO: Ensure that you mark it @generated NOT after code completion&#xD;&#xA;throw new UnsupportedOperationException();&#xD;&#xA;"/>
      </eAnnotations>
      <eParameters name="player" eType="//Player"/>
    </eOperations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ConsolePlayer" eSuperTypes="//Player">
    <eOperations name="nextMove" eType="//Move">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="true"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Summary:&#xA;Prompts the human user to choose one move from the provided list of already-validated legal moves,&#xA;repeatedly parsing input until a valid move is entered.&#xA;Algorithm:&#xA;1. Display available moves and prompt for input in the form &quot;source->destination&quot;.&#xA;2. Read user input from the console.&#xA;3. Parse source and destination coordinates:&#xA;   - column letter a,b,c,... maps to x = 0,1,2,...&#xA;   - row number 1,2,3,... maps to y = 0,1,2,...&#xA;4. Build a Move from the parsed coordinates.&#xA;5. Check whether the parsed move exists in availableMoves.&#xA;6. If valid, return the matching move.&#xA;7. If invalid, print an error message and repeat from step 2.&#xA;Related Features:&#xA;- Player.name&#xA;- Player.color&#xA;- Player.score&#xA;- Player.nextMove()&#xA;Related Classes: Game, Move, Place, Player&#xA;Input:&#xA;- game: current Game instance, used for context and possibly display.&#xA;- availableMoves: list of moves already validated by the game.&#xA;Output:&#xA;- A Move selected by the user from availableMoves.&#xA;- The returned move is guaranteed to be an element of availableMoves.&#xA;Pre-condition:&#xA;- game is not null.&#xA;- availableMoves is not null and contains at least one legal move.&#xA;- Console input is available.&#xA;Post-condition:&#xA;- No game state is modified by this method directly.&#xA;- The returned move matches one of the provided legal moves."/>
        <details key="body" value="// TODO: Please generate a body of this unimplemented method based on the docstring&#xD;&#xA;// TODO: Replace the current body with the generated body &#xD;&#xA;// TODO: Ensure that you mark it @generated NOT after code completion&#xD;&#xA;throw new UnsupportedOperationException();&#xD;&#xA;"/>
      </eAnnotations>
      <eParameters name="game" eType="//Game"/>
      <eParameters name="availableMoves" upperBound="-1" eType="//Move"/>
    </eOperations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="RandomPlayer" eSuperTypes="//Player">
    <eOperations name="nextMove" eType="//Move">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="true"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Summary:&#xA;Selects and returns one move chosen uniformly at random from the provided list of available moves.&#xA;Algorithm:&#xA;1. If availableMoves is null or empty, return null.&#xA;2. Generate a random integer index i such that 0 &lt;= i &lt; availableMoves.size().&#xA;3. Return availableMoves.get(i).&#xA;Related Features:&#xA;- Player.nextMove()&#xA;- Player.name&#xA;- Player.color&#xA;- Player.score&#xA;Related Classes: Game, Move&#xA;Input:&#xA;- game: the current Game instance. It is provided for compatibility with the Player.nextMove signature and is not modified by this operation.&#xA;- availableMoves: a list of already validated legal moves for the current player; may be empty.&#xA;Output:&#xA;- A Move selected at random from availableMoves, or null if availableMoves is empty.&#xA;Pre-condition:&#xA;- game is not null.&#xA;- availableMoves is not null.&#xA;Post-condition:&#xA;- The game state is unchanged.&#xA;- If availableMoves is non-empty, the returned move is an element of availableMoves."/>
        <details key="body" value="// TODO: Please generate a body of this unimplemented method based on the docstring&#xD;&#xA;// TODO: Replace the current body with the generated body &#xD;&#xA;// TODO: Ensure that you mark it @generated NOT after code completion&#xD;&#xA;throw new UnsupportedOperationException();&#xD;&#xA;"/>
      </eAnnotations>
      <eParameters name="game" eType="//Game"/>
      <eParameters name="availableMoves" upperBound="-1" eType="//Move"/>
    </eOperations>
  </eClassifiers>
