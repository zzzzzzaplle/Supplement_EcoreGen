    <eOperations name="clone" eType="//Game">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="manual"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="body" value=" // 1. 使用 EMF 原生复制，彻底抛弃 java.lang.Cloneable 接口和 super.clone()&#xA;&#x9;    // EcoreUtil.copy 会自动帮你处理好 EMF 底层的各种状态&#xA;&#x9;    Game cloned = (Game) org.eclipse.emf.ecore.util.EcoreUtil.copy(this);&#xA;&#x9;    &#xA;&#x9;    // 2. 手动深拷贝二维数组 board (因为 EcoreUtil.copy 无法深拷贝原生多维数组)&#xA;&#x9;    edu.pa20.Piece[][] originalBoard = this.getBoard();&#xA;&#x9;    if (originalBoard != null) {&#xA;&#x9;        int size = this.getConfiguration().getSize();&#xA;&#x9;        edu.pa20.Piece[][] clonedBoard = new edu.pa20.Piece[size][];&#xA;&#x9;        for (int i = 0; i &lt; size; i++) {&#xA;&#x9;            clonedBoard[i] = new edu.pa20.Piece[size];&#xA;&#x9;            // 浅拷贝 Piece 引用即可&#xA;&#x9;            System.arraycopy(originalBoard[i], 0, clonedBoard[i], 0, size);&#xA;&#x9;        }&#xA;&#x9;        cloned.setBoard(clonedBoard);&#xA;&#x9;    }&#xA;&#x9;    &#xA;&#x9;    // 3. 拷贝 currentPlayer 和 Configuration&#xA;&#x9;    // 注意：如果在你的 Ecore 模型中，currentPlayer 和 configuration 不是 containment=&quot;true&quot;，&#xA;&#x9;    // 那么 EcoreUtil.copy 只做了浅拷贝，你需要像下面这样手动触发深拷贝。&#xA;&#x9;    // 如果它们是 containment=&quot;true&quot;，则以下代码可以删除，因为 EcoreUtil 已经拷过了。&#xA;&#x9;    if (this.getConfiguration() != null) {&#xA;&#x9;        try {&#xA;&#x9;            cloned.setConfiguration(this.getConfiguration().clone());&#xA;&#x9;        } catch (Exception e) {&#xA;&#x9;            throw new RuntimeException(&quot;Configuration clone failed&quot;, e);&#xA;&#x9;        }&#xA;&#x9;    }&#xA;&#x9;    if (this.getCurrentPlayer() != null) {&#xA;&#x9;        // currentPlayer 是非 containment 引用；测试里通常是 MockPlayer（非 EMF 对象），不能用 EMF 的 EcoreUtil.copy&#xA;&#x9;        cloned.setCurrentPlayer(this.getCurrentPlayer());&#xA;&#x9;    }&#xA;&#x9;    &#xA;&#x9;    return cloned;"/>
      </eAnnotations>
    </eOperations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="configuration" lowerBound="1" eType="//Configuration"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="board" eType="//PieceArray2D"/>
