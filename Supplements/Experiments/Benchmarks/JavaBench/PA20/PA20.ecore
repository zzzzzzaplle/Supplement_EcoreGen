        <details key="body" value="// Use EMF Factory to instantiate temporary Place object&#xA;Place tempPlace = Pa20Factory.eINSTANCE.createPlace();&#xA;tempPlace.setX(x);&#xA;tempPlace.setY(y);&#xA;// Delegate to another overloaded method&#xA;return this.getPiece(tempPlace);"/>
      </eAnnotations>
