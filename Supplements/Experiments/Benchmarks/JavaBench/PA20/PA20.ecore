    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Move">
    <eOperations name="clone" eType="//Move">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="manual"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="body" value="// Use EMF utilities for basic object cloning&#xA;Move cloned = (Move) org.eclipse.emf.ecore.util.EcoreUtil.copy(this);&#xA;&#xA;// Since source and destination are not containment=true, EcoreUtil.copy only performs shallow copy of references&#xA;// Need to manually create new Place objects to implement deep copy logic from original code&#xA;if (this.getSource() != null) {&#xA;    Place newSource = Pa20Factory.eINSTANCE.createPlace();&#xA;    newSource.setX(this.getSource().getX());&#xA;    newSource.setY(this.getSource().getY());&#xA;    cloned.setSource(newSource);&#xA;}&#xA;&#xA;if (this.getDestination() != null) {&#xA;    Place newDest = Pa20Factory.eINSTANCE.createPlace();&#xA;    newDest.setX(this.getDestination().getX());&#xA;    newDest.setY(this.getDestination().getY());&#xA;    cloned.setDestination(newDest);&#xA;}&#xA;&#xA;return cloned;"/>
      </eAnnotations>
    </eOperations>
    <eOperations name="equal">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="manual"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="body" value="if (this == o) return true;&#xA;if (o == null || getClass() != o.getClass()) return false;&#xA;Move move = (Move) o;&#xA;&#xA;// 1. Manually compare Source coordinate values (null-safe)&#xA;Place s1 = this.getSource();&#xA;Place s2 = move.getSource();&#xA;boolean sourceEq = (s1 == s2) || &#xA;                   (s1 != null &amp;&amp; s2 != null &amp;&amp; s1.getX() == s2.getX() &amp;&amp; s1.getY() == s2.getY());&#xA;&#xA;// 2. Manually compare Destination coordinate values (null-safe)&#xA;Place d1 = this.getDestination();&#xA;Place d2 = move.getDestination();&#xA;boolean destEq = (d1 == d2) || &#xA;                 (d1 != null &amp;&amp; d2 != null &amp;&amp; d1.getX() == d2.getX() &amp;&amp; d1.getY() == d2.getY());&#xA;&#xA;return sourceEq &amp;&amp; destEq;"/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
      <eParameters name="o">
        <eType xsi:type="ecore:EDataType" href="http://www.eclipse.org/emf/2002/Ecore#//EJavaObject"/>
      </eParameters>
    </eOperations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="source" lowerBound="1" eType="//Place"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="destination" lowerBound="1" eType="//Place"/>
  </eClassifiers>
