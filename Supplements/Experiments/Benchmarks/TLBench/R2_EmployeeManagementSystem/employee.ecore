<?xml version="1.0" encoding="UTF8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="employee" nsURI="http://www.example.org/employee" nsPrefix="employee">
  <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
    <details key="requirement" value="Employee Management System&#xA;The employee management system manages a named company that owns multiple departments and employs workers, salespeople, and managers.&#xA;Every employee stores the department label, name, birth date, and social insurance number.&#xA;Workers store weekly working hours and hourly rates.&#xA;Off-shift workers additionally store whether they have a weekend permit and whether they have an official holiday permit.&#xA;Shift workers additionally store a holiday premium and can only belong to the Delivery department.&#xA;Salespeople store a fixed salary, an amount of sales, and a commission percentage.&#xA;Managers store a fixed salary, a position title, and a list of direct subordinate employees.&#xA;Each department is identified by a department type of PRODUCTION, CONTROL, or DELIVERY, stores its employees, and is controlled by one manager.&#xA;The company can calculate the total salary of all employees, the total commission amount of all salespeople, and the total holiday premiums paid to all shift workers. Monetary results are rounded to two decimal places.&#xA;A department can calculate the average weekly working hours of its workers and returns 0 when the department has no workers. The average is rounded to two decimal places.&#xA;A manager can return the number of direct subordinate employees.&#xA;Functional requirement:&#xA;1. Calculate the total salary of all employees in the company. Total salary equals the sum of workers' salary, salespeople's salary, and managers' salary. Workers' salary equals weeklyWorkingHour multiplied by hourlyRates, plus holiday premiums for shift workers. Salespeople's salary equals salary plus amountOfSales multiplied by commissionPercentage. Managers' salary equals salary. Retain two decimal places for the return value.&#xA;2. Calculate the average weekly working hours for all workers within a given department. The method operates on a Department instance and computes the average of all Worker employees' weeklyWorkingHour in that department's employee list. Return 0 if there are no workers in the department. Retain two decimal places for the return value.&#xA;3. Determine the total commission amount for all salespeople in the company. Sum amountOfSales multiplied by commissionPercentage for all salespeople. Retain two decimal places for the return value.&#xA;4. Calculate the total holiday premiums paid to all shift workers in the company. Shift workers can only belong to the Delivery department; the setDepartment method of ShiftWorker shall throw an IllegalArgumentException when the department is null or not &quot;Delivery&quot;. Retain two decimal places for the return value. Return 0 if there are no shift workers in the company.&#xA;5. Get the number of direct subordinate employees for each manager."/>
  </eAnnotations>
  <eClassifiers xsi:type="ecore:EEnum" name="DepartmentType">
    <eLiterals name="PRODUCTION"/>
    <eLiterals name="CONTROL" value="1"/>
    <eLiterals name="DELIVERY" value="2"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Employee" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="department" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="birthDate" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="socialInsuranceNumber"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="company" lowerBound="1"
        eType="#//Company" eOpposite="#//Company/employees"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Worker" abstract="true" eSuperTypes="#//Employee">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="weeklyWorkingHour" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="hourlyRates" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Manager" eSuperTypes="#//Employee">
    <eOperations name="getDirectSubordinateEmployeesCount" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="true"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Summary: Gets the number of direct subordinate employees for the manager.&#xA;Algorithm: &#xA;1. Return the size of the subordinates list.&#xA;Input: None&#xA;Output: The number of direct subordinate employees for the manager (int)&#xA;Pre-condition: The manager has been initialized with subordinates.&#xA;Post-condition: The count is returned."/>
        <details key="body" value="// TODO: Please generate a body of this unimplemented method based on the docstring&#xD;&#xA;// TODO: Replace the current body with the generated body &#xD;&#xA;// TODO: Ensure that you mark it @generated NOT after code completion&#xD;&#xA;throw new UnsupportedOperationException();&#xD;&#xA;"/>
      </eAnnotations>
    </eOperations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="salary" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="position" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="subordinates" upperBound="-1"
        eType="#//Employee"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="SalesPeople" eSuperTypes="#//Employee">
    <eOperations name="getTotalCommission" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="true"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Summary: Calculates the total commission for the salesperson.&#xA;Algorithm: &#xA;1. Return amountOfSales * commissionPercentage.&#xA;Input: None&#xA;Output: The total commission for the salesperson (double)&#xA;Pre-condition: The salesperson has been initialized with amountOfSales and commissionPercentage.&#xA;Post-condition: The total commission is calculated and returned."/>
        <details key="body" value="// TODO: Please generate a body of this unimplemented method based on the docstring&#xD;&#xA;// TODO: Replace the current body with the generated body &#xD;&#xA;// TODO: Ensure that you mark it @generated NOT after code completion&#xD;&#xA;throw new UnsupportedOperationException();&#xD;&#xA;"/>
      </eAnnotations>
    </eOperations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="salary" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="amountOfSales" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="commissionPercentage" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ShiftWorker" eSuperTypes="#//Worker">
    <eOperations name="calculateHolidayPremium" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="true"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Summary: Calculates the holiday premium for the shift worker.&#xA;Algorithm: &#xA;1. Return holidayPremium.&#xA;Input: None&#xA;Output: The holiday premium for the shift worker (double)&#xA;Pre-condition: The shift worker has been initialized with holidayPremium.&#xA;Post-condition: The holiday premium is returned."/>
        <details key="body" value="// TODO: Please generate a body of this unimplemented method based on the docstring&#xD;&#xA;// TODO: Replace the current body with the generated body &#xD;&#xA;// TODO: Ensure that you mark it @generated NOT after code completion&#xD;&#xA;throw new UnsupportedOperationException();&#xD;&#xA;"/>
      </eAnnotations>
    </eOperations>
    <eOperations name="setdepartment">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="manual"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="body" value="if (department == null || !&quot;Delivery&quot;.equalsIgnoreCase(department)) {&#xA;            throw new IllegalArgumentException(&quot;Shift workers can only work in the Delivery department.&quot;);&#xA;        }&#xA;        super.setDepartment(&quot;Delivery&quot;);"/>
      </eAnnotations>
      <eParameters name="department" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eOperations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="holidayPremium" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="OffShiftWorker" eSuperTypes="#//Worker">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="weekendPermit" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="officialHolidayPermit"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Department">
    <eOperations name="calculateAverageWorkerWorkingHours" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="true"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Summary: Calculates the average working hours per week for all workers in the department.&#xA;Algorithm: &#xA;1. Initialize totalWorkingHours to 0 and workerCount to 0.&#xA;2. Iterate through all employees in the department.&#xA;3. For each employee, check if it's a Worker.&#xA;4. If it's a Worker, add its weeklyWorkingHour to totalWorkingHours and increment workerCount.&#xA;5. If workerCount is 0, return 0.&#xA;6. Return totalWorkingHours / workerCount.&#xA;Input: None&#xA;Output: The average working hours per week for all workers in the department (double)&#xA;Pre-condition: The department has been initialized with employees.&#xA;Post-condition: The average working hours are calculated and returned."/>
        <details key="body" value="// TODO: Please generate a body of this unimplemented method based on the docstring&#xD;&#xA;// TODO: Replace the current body with the generated body &#xD;&#xA;// TODO: Ensure that you mark it @generated NOT after code completion&#xD;&#xA;throw new UnsupportedOperationException();&#xD;&#xA;"/>
      </eAnnotations>
    </eOperations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="type" eType="#//DepartmentType"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="manager" lowerBound="1"
        eType="#//Manager"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="employees" upperBound="-1"
        eType="#//Employee"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="company" lowerBound="1"
        eType="#//Company" eOpposite="#//Company/departments"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Company">
    <eOperations name="calculateTotalEmployeeSalary" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="true"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Summary: Calculates the total salary of all employees in the company.&#xA;Algorithm: &#xA;1. Initialize totalSalary to 0.&#xA;2. Iterate through all employees in the company.&#xA;3. For each employee, check its type.&#xA;4. If it's a Worker, add its salary (weeklyWorkingHour * hourlyRates + holiday premiums if it's a ShiftWorker) to totalSalary.&#xA;5. If it's a SalesPeople, add its salary (salary + amountOfSales * commissionPercentage) to totalSalary.&#xA;6. If it's a Manager, add its salary to totalSalary.&#xA;7. Return totalSalary.&#xA;Input: None&#xA;Output: The total salary of all employees in the company (double)&#xA;Pre-condition: The company has been initialized with employees.&#xA;Post-condition: The total salary is calculated and returned."/>
        <details key="body" value="// TODO: Please generate a body of this unimplemented method based on the docstring&#xD;&#xA;// TODO: Replace the current body with the generated body &#xD;&#xA;// TODO: Ensure that you mark it @generated NOT after code completion&#xD;&#xA;throw new UnsupportedOperationException();&#xD;&#xA;"/>
      </eAnnotations>
    </eOperations>
    <eOperations name="calculateTotalSalesPeopleCommission" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="true"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Summary: Calculates the total commission amount for all salespeople in the company.&#xA;Algorithm: &#xA;1. Initialize totalCommission to 0.&#xA;2. Iterate through all employees in the company.&#xA;3. For each employee, check if it's a SalesPeople.&#xA;4. If it's a SalesPeople, add its commission (amountOfSales * commissionPercentage) to totalCommission.&#xA;5. Return totalCommission.&#xA;Input: None&#xA;Output: The total commission amount for all salespeople in the company (double)&#xA;Pre-condition: The company has been initialized with employees.&#xA;Post-condition: The total commission is calculated and returned."/>
        <details key="body" value="// TODO: Please generate a body of this unimplemented method based on the docstring&#xD;&#xA;// TODO: Replace the current body with the generated body &#xD;&#xA;// TODO: Ensure that you mark it @generated NOT after code completion&#xD;&#xA;throw new UnsupportedOperationException();&#xD;&#xA;"/>
      </eAnnotations>
    </eOperations>
    <eOperations name="calculateTotalShiftWorkerHolidayPremiums" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble">
      <eAnnotations source="http://www.ustb.edu.cn/sei/mde/EnhancedCodeGen">
        <details key="generated" value="true"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Summary: Calculates the total holiday premiums paid to all shift workers in the company.&#xA;Algorithm: &#xA;1. Initialize totalHolidayPremiums to 0.&#xA;2. Iterate through all employees in the company.&#xA;3. For each employee, check if it's a ShiftWorker.&#xA;4. If it's a ShiftWorker, add its holiday premium to totalHolidayPremiums.&#xA;5. Return totalHolidayPremiums.&#xA;Input: None&#xA;Output: The total holiday premiums paid to all shift workers in the company (double)&#xA;Pre-condition: The company has been initialized with employees.&#xA;Post-condition: The total holiday premiums are calculated and returned."/>
        <details key="body" value="// TODO: Please generate a body of this unimplemented method based on the docstring&#xD;&#xA;// TODO: Replace the current body with the generated body &#xD;&#xA;// TODO: Ensure that you mark it @generated NOT after code completion&#xD;&#xA;throw new UnsupportedOperationException();&#xD;&#xA;"/>
      </eAnnotations>
    </eOperations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="departments" upperBound="-1"
        eType="#//Department" containment="true" eOpposite="#//Department/company"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="employees" upperBound="-1"
        eType="#//Employee" containment="true" eOpposite="#//Employee/company"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
</ecore:EPackage>
